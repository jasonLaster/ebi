FMP_API_KEY=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Issue alerts (Resend). ALERT_EMAIL_FROM defaults to onboarding@resend.dev,
# which can only deliver to the Resend account owner's address.
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`; full /api/sync runs require it.
CRON_SECRET=

# Only needed for the optional `bun run sync --download` PDF path.
HYPERBROWSER_API_KEY=
